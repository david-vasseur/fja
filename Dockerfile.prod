# ==== Phase 1 : Builder ====
FROM node:24-bookworm AS builder

WORKDIR /app

ENV NODE_OPTIONS="--max-old-space-size=1536"
ENV NEXT_TELEMETRY_DISABLED=1

COPY package*.json ./
RUN npm ci

COPY . .

RUN npm run build


# ==== Phase 2 : Image finale légère ====
FROM node:24-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=512"
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=4001
ENV HOSTNAME="0.0.0.0"

# 1. Dépendances système minimales
RUN apt-get update -y && \
    apt-get install -y --no-install-recommends ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# 2. Création de l'utilisateur non-root AVANT la copie
RUN groupadd -g 1001 nodejs && \
    useradd -u 1001 -g nodejs -s /bin/sh nextjs

# 3. Copie avec attribution directe des droits
COPY --chown=nextjs:nodejs --from=builder /app ./

# 4. Basculer sur l'utilisateur non-privilégié
USER nextjs

EXPOSE 4001

CMD ["npm", "start"]
